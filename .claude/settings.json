{
  "model": "claude-opus-5-5",
  "ultracode": true,
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout -b feat/*)",
      "Bash(git switch*)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push origin feat/*)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(npm test*)",
      "Bash(npm run *)",
      "Bash(npx vitest*)",
      "Bash(npx eslint*)",
      "Bash(npx tsc*)",
      "Bash(uv run *)",
      "Bash(pytest*)",
      "Bash(railway status*)",
      "Bash(railway logs*)",
      "Bash(railway environment*)",
      "Bash(python scripts/*)",
      "Bash(bash scripts/*)",
      "Bash(codex exec*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push -u origin main*)",
      "Bash(rm -rf*)",
      "Bash(railway up*)",
      "Bash(railway redeploy*)",
      "Bash(railway variables set*)",
      "Bash(railway variables delete*)",
      "Bash(railway delete*)",
      "Bash(railway down*)",
      "Bash(railway environment delete*)",
      "Bash(railway service delete*)",
      "PowerShell",
      "Read(./.claude/settings.local.json)",
      "Read(**/.claude/settings.local.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(**/.claude/settings.local.json)",
      "Write(./.claude/settings.local.json)",
      "Write(**/.claude/settings.local.json)",
      "Read(~/.talos-gh/**)",
      "Edit(~/.talos-gh/**)",
      "Write(~/.talos-gh/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-commands.sh\"" }
        ]
      }
    ]
  }
}
